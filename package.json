  "version": "1.0.0",
  "description": "An AI guards a vault of $WIF on Robinhood Chain. Argue your way past it.",
  "main": "src/server.mjs",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "test": "node scripts/compile.mjs && node --test test/vault.test.mjs",
