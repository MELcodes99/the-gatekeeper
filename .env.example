# Robinhood Chain
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Wallets (use fresh wallets, never your main one)
# Deployer: deploys the vault and seeds the pot. Needs ETH for gas and $WIF for the seed.
DEPLOYER_PRIVATE_KEY=0x...
# Gatekeeper: the agent's key. Can only rule on attempts. Needs a little ETH for gas.
GATEKEEPER_PRIVATE_KEY=0x...

# Filled in after `npm run deploy`
VAULT_ADDRESS=
START_BLOCK=

# Agent
ANTHROPIC_API_KEY=sk-ant-...
MODEL=claude-sonnet-5-5
PORT=3000

# Game settings used by `npm run deploy` (whole $WIF, bps = parts per 10,000)
BASE_FEE=1000
FEE_STEP_BPS=100
MAX_FEE=10000
BURN_BPS=3000
WINNER_BPS=8000
TIMEOUT=3600
